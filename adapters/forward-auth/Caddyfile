# Caddy forward_auth with jev-edge. Caddy never forwards the body, so the
# verdict is `skipped` unless the client IP has a reputation entry; use this
# for reputation enforcement on top of another judging path, or move judgment
# into the OpenResty adapter behind Caddy.
:80 {
    # `route` keeps the written order: Caddy's default directive order runs
    # forward_auth BEFORE request_header, which would strip the real verdict.
    route {
        # never trust a client-supplied verdict: strip before forward_auth runs
        request_header -X-Jev-Verdict
        request_header -X-Jev-Score
        request_header -X-Jev-Source
        request_header -X-Jev-Reason
        request_header -X-Jev-Request-Id
        request_header -X-Jev-Subject
        # forward_auth copies every request header to jev-edge, which can take
        # the client IP from these instead of the X-Forwarded-For Caddy sets
        request_header -X-Envoy-External-Address
        request_header -X-Real-IP
        forward_auth jev-edge:8080 {
            uri /_jev/forward-auth
            copy_headers X-Jev-Verdict X-Jev-Score X-Jev-Source X-Jev-Reason X-Jev-Request-Id
            # Caddy sets X-Forwarded-Method and X-Forwarded-Uri itself.
        }
        reverse_proxy app:8081
    }
}
