{
  "name": "@jev-edge/js",
  "version": "0.6.0",
  "description": "jev-edge for JavaScript runtimes: Cloudflare Workers and Pages, Next.js, Node, Hono, Lambda@Edge, Deno Deploy. Same core contract as the OpenResty adapter.",
  "keywords": [
    "jev-edge",
    "prompt-injection",
    "llm",
    "ai-security",
    "waf",
    "middleware",
    "cloudflare-workers",
    "nextjs",
    "hono",
    "express",
    "lambda-edge",
    "deno"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/kiwi0719/jev-edge/tree/main/adapters/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwi0719/jev-edge.git",
    "directory": "adapters/js"
  },
  "bugs": {
    "url": "https://github.com/kiwi0719/jev-edge/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./frameworks": {
      "types": "./dist/frameworks.d.ts",
      "import": "./dist/frameworks.js"
    },
    "./aws": {
      "types": "./dist/aws.d.ts",
      "import": "./dist/aws.js"
    },
    "./deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "wrangler.thin.toml",
    "wrangler.full.toml"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden": "vitest run test/golden.test.ts",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc --noEmit && vitest run && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^20.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
