    {
      "expect": {
        "kind": "multipart",
        "text": "field text\nfile text"
      },
      "input": {
        "body": "--B1\r\nContent-Disposition: form-data; name=\"prompt\"\r\n\r\nfield text\r\n--B1\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nfile text\r\n--B1\r\nContent-Disposition: form-data; name=\"i\"; filename=\"a.png\"\r\nContent-Type: image/png\r\n\r\n\u0000PNG\r\n--B1--\r\n",
        "content_type": "multipart/form-data; boundary=B1",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "multipart fields and text files, binary files skipped"
    },
    {
      "expect": {
        "kind": "form",
        "text": "b\n=d\n"
      },
      "input": {
        "body": "=a=b&c==d&e&=&f=",
