    {
      "expect": {
        "kind": "form",
        "text": "bare form\n2"
      },
      "input": {
        "body": "prompt=bare+form&n=2",
        "content_type": null,
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "no content type, form body"
    },
    {
      "expect": {
        "kind": "text",
        "text": "{not json"
      },
      "input": {
        "body": "{not json",
        "content_type": "text/plain",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "text/plain that is not JSON stays text"
    },
    {
      "expect": {
        "kind": "binary",
        "text": ""
      },
      "input": {
        "body": "\u0000\u0001\u0002\u0003binary",
        "content_type": "application/octet-stream",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
