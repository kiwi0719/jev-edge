        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "a lone surrogate escape in another field does not hide the text"
    },
    {
      "expect": {
        "kind": "json",
        "text": "a�b�c��d"
      },
      "input": {
        "body": "{\"prompt\":\"a\\ud800b\\uDC00c\\ud800\\ud800d\"}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "a lone surrogate escape is read as U+FFFD"
