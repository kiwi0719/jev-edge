    {
      "expect": {
        "kind": "json",
        "text": "😀 ok"
      },
      "input": {
        "body": "{\"prompt\":\"\\ud83d\\ude00 ok\"}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "a surrogate pair escape is one character"
    },
    {
      "expect": {
        "kind": "json",
        "text": "C:\\ud800"
      },
      "input": {
        "body": "{\"prompt\":\"C:\\\\ud800\"}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "an escaped backslash before u is not an escape"
    },
