{
  "cases": [
    {
      "expect": {
        "kind": "json",
        "text": "You are helpful.\nHi there"
      },
      "input": {
        "body": "{\"messages\":[{\"role\":\"system\",\"content\":\"You are helpful.\"},{\"role\":\"user\",\"content\":\"Hi there\"}]}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "chat messages joined with newline"
    },
    {
      "expect": {
        "kind": "json",
        "text": "Summarise this"
      },
      "input": {
        "body": "{\"prompt\":\"Summarise this\",\"max_tokens\":10}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "prompt field"
    },
    {
      "expect": {
        "kind": "json",
        "text": "first\nsecond\nthird"
      },
      "input": {
        "body": "{\"text\":\"third\",\"prompt\":\"first\",\"query\":\"second\"}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "several fields present, in field order"
    },
    {
      "expect": {
        "kind": "json",
        "text": "deep"
      },
      "input": {
        "body": "{\"input\":{\"text\":\"deep\"}}",
        "content_type": "application/json",
        "fields": [
          "input.text"
        ]
      },
      "name": "nested path"
    },
    {
      "expect": {
        "kind": "json",
        "text": "a\nb"
      },
      "input": {
        "body": "{\"prompt\":42,\"messages\":[{\"content\":[\"a\",\"b\"]}]}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "numbers are ignored, string arrays are joined"
    },
    {
      "expect": {
        "kind": "json",
        "text": "part one\npart two"
      },
      "input": {
        "body": "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"part one\"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"x\"}},{\"type\":\"text\",\"text\":\"part two\"}]}]}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "openai content parts"
    },
    {
      "expect": {
        "kind": "json",
        "text": "nested"
      },
      "input": {
        "body": "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":[{\"type\":\"text\",\"text\":\"nested\"}]}]}]}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "anthropic tool_result nests content once more"
    },
    {
      "expect": {
        "kind": "json",
        "text": "resp"
      },
      "input": {
        "body": "{\"input\":[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"resp\"}]}]}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "responses api input_text parts"
    },
    {
      "expect": {
        "kind": "json",
        "text": "with charset"
      },
      "input": {
        "body": "{\"prompt\":\"with charset\"}",
        "content_type": "application/json; charset=utf-8",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "json with charset parameter"
    },
    {
      "expect": {
        "kind": "json",
        "text": "vendor"
      },
      "input": {
        "body": "{\"prompt\":\"vendor\"}",
        "content_type": "application/vnd.acme+json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "vendor +json suffix"
    },
    {
      "expect": {
        "kind": "invalid",
        "text": ""
      },
      "input": {
        "body": "{\"prompt\":",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "invalid json"
    },
    {
      "expect": {
        "kind": "json",
        "text": "after null"
      },
      "input": {
        "body": "{\"messages\":[null,{\"role\":\"user\",\"content\":\"after null\"}]}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "a null message does not end the list"
    },
    {
      "expect": {
        "kind": "json",
        "text": "after null part"
      },
      "input": {
        "body": "{\"messages\":[{\"role\":\"user\",\"content\":[null,{\"type\":\"text\",\"text\":\"after null part\"}]}]}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "a null content part does not end the parts"
    },
    {
      "expect": {
        "kind": "json",
        "text": "after bom"
      },
      "input": {
        "body": "﻿{\"prompt\":\"after bom\"}",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "UTF-8 BOM before json is skipped"
    },
    {
      "expect": {
        "kind": "none",
        "text": ""
      },
      "input": {
        "body": "",
        "content_type": "application/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "empty body"
    },
    {
      "expect": {
        "kind": "form",
        "text": "hello world!\n1"
      },
      "input": {
        "body": "prompt=hello+world%21&x=1",
        "content_type": "application/x-www-form-urlencoded",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "form urlencoded decodes plus and percent"
    },
    {
      "expect": {
        "kind": "text",
        "text": "plain text body"
      },
      "input": {
        "body": "plain text body",
        "content_type": "text/plain",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "text/plain is the body itself"
    },
    {
      "expect": {
        "kind": "text",
        "text": "no ct"
      },
      "input": {
        "body": "no ct",
        "content_type": null,
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "no content type is treated as text"
    },
    {
      "expect": {
        "kind": "json",
        "text": "x"
      },
      "input": {
        "body": "{\"prompt\":\"x\"}",
        "content_type": "application/octet-stream",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "JSON under a non-JSON content type is read as JSON"
    },
    {
      "expect": {
        "kind": "json",
        "text": "text json"
      },
      "input": {
        "body": "{\"prompt\":\"text json\"}",
        "content_type": "text/json",
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "text/json is JSON"
    },
    {
      "expect": {
        "kind": "json",
        "text": "bare"
      },
      "input": {
        "body": "{\"prompt\":\"bare\"}",
        "content_type": null,
        "fields": [
          "messages[*].content",
          "prompt",
          "input",
          "query",
          "text"
        ]
      },
      "name": "no content type, JSON body"
